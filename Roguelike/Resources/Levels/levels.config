; Реестр локаций. Порядок в файле = порядок прохождения внутри своего вида.
; Новая локация добавляется блоком, пересборка не нужна.
;
; mode: campaign - сюжет (по умолчанию), arena - карта режима арены, test - вне прохождения.
; Шаг по умолчанию идёт к следующей локации того же вида, поэтому отладочная карта,
; положенная между сюжетными, прохождение не ломает.

[level prison]
title Тюрьма
act Resources/Acts/act1_prison.config

[level bridge]
title Мост
act Resources/Acts/act1_bridge.config

[level street]
title Улица
act Resources/Acts/act1_street.config

[level city]
title Городские руины
mode test
file Resources/Levels/test_level.config

[level catacombs]
title Катакомбы
mode test
file Resources/Levels/catacombs.config

[level arena]
title Арена
mode arena
