drop ammo_pistol 2 1
nothing 2

[table heavy]
drop ammo_shell 4 1
drop potion_small 2 1
nothing 2

[table radio]
drop potion_small 3 1
drop ammo_pistol 2 1
nothing 3

[table boss]
rolls 3
drop potion_small 3 1
drop ammo_rifle 2 1
drop ammo_shell 2 1
