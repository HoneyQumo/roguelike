; Каталог реплик. Новая реплика добавляется блоком, пересборка не нужна.
; speaker: кто говорит, это имя видно в субтитре. text: что сказано.
; sound: ключ звука в Resources/Audio/Voice - без пути и расширения.
; say: как это произнести, разметкой SSML. Нет строки - читается text.
;
; [set <ключ>] - список реплик на один повод, из него выбирают по случаю.
;
; Тянущаяся гласная пишется удвоением, без дефиса: дефис внутри слова
; модель читает как разрыв, и слово рвётся надвое.
;
; Кто говорит: охрана тюрьмы, из которой сбежал герой. Говорят как силовики -
; громко, коротко, без раздумий. Пауз внутри команды нет: команда не тянется.

[line guard_spotted_1]
speaker Охранник
text Стой! Кто идёт?
say <speak><prosody rate="110%" pitch="high">Стооой! Кто идёт?!</prosody></speak>
sound voice_guard_1

[line guard_spotted_2]
speaker Охранник
text Э, алё, гараж!
say <speak><prosody rate="110%" pitch="high">Ээ! Алёё! Гараж!</prosody></speak>
sound voice_guard_2

[line guard_spotted_3]
speaker Охранник
text Вот ты где!
say <speak><prosody rate="110%" pitch="high">Вот ты где!</prosody></speak>
sound voice_guard_3

[line guard_spotted_4]
speaker Охранник
text Куда намылился?!
say <speak><prosody rate="110%" pitch="high">Куда намылился?!</prosody></speak>
sound voice_guard_4

[line heavy_spotted_1]
speaker Тяжёлый
text Стоять! Кому сказал!
say <speak><prosody rate="110%" pitch="low">Стояять! Кому сказал!</prosody></speak>
sound voice_heavy_1

[line heavy_spotted_2]
speaker Тяжёлый
text Попался, крыса!
say <speak><prosody rate="110%" pitch="low">Попался, крыса!</prosody></speak>
sound voice_heavy_2

[line heavy_spotted_3]
speaker Тяжёлый
text Взять его! Живо!
say <speak><prosody rate="110%" pitch="low">Взять его! Живо!</prosody></speak>
sound voice_heavy_3

[line heavy_spotted_4]
speaker Тяжёлый
text Далеко собрался?!
say <speak><prosody rate="110%" pitch="low">Далеко собрался?!</prosody></speak>
sound voice_heavy_4

[line radio_spotted_1]
speaker Радист
text Тревога! Беглец в секторе!
say <speak><prosody rate="110%" pitch="high">Тревоога! Беглец в секторе!</prosody></speak>
sound voice_radio_1

[line radio_spotted_2]
speaker Радист
text Чужой на базе! Приём!
say <speak><prosody rate="110%" pitch="high">Чужой на базе! Приём!</prosody></speak>
sound voice_radio_2

[line radio_spotted_3]
speaker Радист
text Все сюда! Быстро!
say <speak><prosody rate="110%" pitch="high">Все сюдаа! Быстро!</prosody></speak>
sound voice_radio_3

[line radio_spotted_4]
speaker Радист
text Внимание! Он здесь!
say <speak><prosody rate="110%" pitch="high">Внимание! Он здесь!</prosody></speak>
sound voice_radio_4

; Оклик на переходе «спокоен - насторожился». Тоже без растягивания: человек
; не тянет, он коротко спрашивает и слушает.

[line guard_notice_1]
speaker Охранник
text Эй! Кто здесь?
say <speak><prosody rate="110%">Ээй! Кто здесь?</prosody></speak>
sound voice_guard_notice_1

