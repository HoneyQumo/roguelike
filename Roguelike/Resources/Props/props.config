; Объекты на карте. Новый добавляется блоком, пересборка не нужна.
; health 0 — неразрушаемый; loot — таблица из loot.config
; key <предмет> - объект открывается по [E] этим ключом
; frame / spentFrame - кадр в атласе; без них объект рисуется заливкой color / brokenColor

[prop crate_wood]
name Ящик
hit impact
health 40
size 48
frame Resources/Textures/props.png 0 0 64 64
spentFrame Resources/Textures/props.png 64 0 64 64
color 150 110 60
brokenColor 80 60 35
loot crate_wood

[prop barrel_rusty]
name Бочка
hit impact
health 25
size 44
frame Resources/Textures/props.png 128 0 64 64
color 120 90 70
brokenColor 70 50 40
loot barrel

[prop crate_empty]
name Пустой ящик
health 30
size 48
frame Resources/Textures/props.png 320 0 64 64
spentFrame Resources/Textures/props.png 384 0 64 64
color 130 100 55
brokenColor 75 55 32

[prop chest_supply]
name Склад снаряжения
key key_rusty
size 48
frame Resources/Textures/props.png 192 0 64 64
spentFrame Resources/Textures/props.png 256 0 64 64
color 120 95 50
openedColor 70 55 30
loot chest_supply
